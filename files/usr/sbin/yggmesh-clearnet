#!/bin/sh
# shellcheck disable=SC3043
# YggMesh — clearnet access through Yggdrasil exit nodes (Crypto-Key Routing).
#
# In the exit clearnet mode (yggmesh.clearnet.mode, exits in
# yggmesh.clearnet.exit) every IPv4 packet from the Wi-Fi clients goes to one
# of the exits, never to WAN. In the wan_exit mode the clients use WAN while
# it works and the exits otherwise. Exits are known by their public keys.
#
#   client 10.0.0.x --NAT44--> 100.x.y.z (the node) --Yggdrasil CKR--> exit
#     --exit NAT44--> the Internet
#
# Yggdrasil-ng carries IPv4 itself: its Crypto-Key Routing sends 0.0.0.0/0 to
# the public key of the active exit (see /etc/init.d/yggdrasil), no
# translation is involved. The node's IPv4 address on the TUN device is
# derived from its key (key_ipv4): the exit derives the same one from the key
# and accepts the node's packets from that address only (YggMesh-exit-node).
# The CKR table is fixed while Yggdrasil runs: switching to another exit
# restarts Yggdrasil, which drops the mesh links of the node for a few
# seconds. Exits are switched as rarely as possible.
#
# Usage:
#   yggmesh-clearnet run      monitor loop, started by /etc/init.d/yggmesh-clearnet
#   yggmesh-clearnet cleanup  remove the routing, after the service stops
#   yggmesh-clearnet current  print the exit Yggdrasil is (to be) configured
#                             with: the active one, or the first configured
#
# Exit selection. Every CHECK_INTERVAL seconds every exit is pinged over
# Yggdrasil (its 200::/8 address, derived from its key): its round trip time
# is the exit's latency (smoothed: rtt = (3 * rtt + sample) / 4). The active
# exit is also checked end to end: a ping request to 1.1.1.1 or 8.8.8.8 from
# the node's IPv4 address, through the exit. It covers the exit's allow list,
# its NAT and its internet access.
#   - the active exit is kept while it works: switching changes the public IP,
#     breaks running connections and restarts Yggdrasil. It is dropped after
#     FAIL_LIMIT failed checks in a row, and is not switched to again for
#     COOLDOWN seconds;
#   - without an active exit the fastest reachable one is used. The exit
#     Yggdrasil already runs with comes last: using it needs no restart, so it
#     is tried again even within its COOLDOWN when nothing else is reachable;
#   - another exit takes over only when it has been reachable for
#     RETURN_LIMIT checks in a row and is clearly faster: below SWITCH_PCT %
#     of the active exit's latency and at least SWITCH_MS ms faster;
#   - without a working exit clients have no clearnet at all: the client
#     routing table holds an unreachable route and the firewall has no
#     LAN -> WAN forwarding in this mode.
#
# WAN in the wan_exit mode. WAN is checked the same way, every CHECK_INTERVAL
# seconds, with requests from the node itself (main routing table). While it
# works, a policy rule in front of the client table sends the client IPv4 to
# the main table, i.e. the WAN default route, with the firewall forwarding
# LAN -> WAN. WAN is dropped after FAIL_LIMIT failed checks in a row, or at
# once when it has no default route; it is used again after WAN_UP_LIMIT good
# checks. The exits are checked all the time, so the failover is immediate.
#
# DNS: dnsmasq also queries 1.0.0.1 and 8.8.4.4 from the node's IPv4 address,
# i.e. through the active exit, so nodes without WAN resolve clearnet names.
# Those servers are written to DNS_FILE (dnsmasq --servers-file, re-read on
# SIGHUP). The file is persistent, so it is ready before dnsmasq starts.
#
# State: STATUS_FILE (exit, address, rtt of the active exit; wan: 1 while
# clients use WAN), rewritten after every check. ACTIVE_FILE: the exit
# Yggdrasil is configured with, read by /etc/init.d/yggdrasil.
#
# Logs: logread -e yggmesh-clearnet

. /usr/share/yggmesh/ygg.sh

TAG="yggmesh-clearnet"
TABLE=64                 # routing table of the client IPv4 traffic
RULE_PRIO=6400           # the clients
SELF_PRIO=6401           # the node itself, from its IPv4 address: checks and DNS
WAN_PRIO=6399            # wan_exit: the client IPv4 uses the main table first
CLIENT_DEV="br-private"
DNS_FILE="/etc/yggmesh/clearnet-dns.conf"
STATUS_FILE="/var/run/yggmesh-clearnet.status"   # for the LuCI page
ACTIVE_FILE="/var/run/yggmesh-clearnet.exit"
CHECK_INTERVAL=30
FAIL_LIMIT=3
RETURN_LIMIT=10
SWITCH_PCT=70
SWITCH_MS=30
COOLDOWN=600
WAN_UP_LIMIT=2

log() {
    logger -t "$TAG" "$*"
}

# Prints the exit Yggdrasil is (to be) configured with: the one in ACTIVE_FILE
# while it is configured, the first configured exit otherwise. Nothing outside
# the exit clearnet modes.
current() {
    local exits e saved
    case "$(uci -q get yggmesh.clearnet.mode)" in
        exit|wan_exit) ;;
        *) return 0 ;;
    esac
    exits=$(uci -q get yggmesh.clearnet.exit | tr 'A-F' 'a-f')
    saved=$(cat "$ACTIVE_FILE" 2>/dev/null)
    for e in $exits; do
        [ "$e" = "$saved" ] && { echo "$e"; return 0; }
    done
    for e in $exits; do
        is_pubkey "$e" && { echo "$e"; return 0; }
    done
}

# Prints the exit the running Yggdrasil was started with, from its configuration
running_exit() {
    sed -n 's/^"\([0-9a-f]\{64\}\)" = .*/\1/p' "$YGG_CONF" 2>/dev/null
}

# Points the extra dnsmasq servers through the exits, from the node's IPv4
# address $1, or nowhere without $1. The file is rewritten in place (dnsmasq
# runs in a jail with this very file bind-mounted) and only when its content
# changes, to spare the flash.
write_dns() {
    local want=""
    [ -n "$1" ] && want=$(printf 'server=1.0.0.1@%s\nserver=8.8.4.4@%s' "$1" "$1")
    [ "$(cat "$DNS_FILE" 2>/dev/null)" = "$want" ] && return 0
    if [ -n "$want" ]; then
        echo "$want" > "$DNS_FILE"
    else
        : > "$DNS_FILE"
    fi
    killall -HUP dnsmasq 2>/dev/null
}

# Client IPv4 goes nowhere: the kill switch. Used at start and whenever no
# exit works, so clients fail fast instead of waiting for timeouts.
route_block() {
    ip -4 route replace unreachable default table "$TABLE"
}

# Client IPv4 goes to Yggdrasil, CKR sends it to the active exit. The route
# goes with the TUN device when Yggdrasil restarts, so it is renewed on every
# check. Returns 1 while the device is missing.
route_exit() {
    ip link show "$YGG_DEV" >/dev/null 2>&1 || return 1
    ip -4 route replace default dev "$YGG_DEV" table "$TABLE"
}

# Creates the policy routing. Everything is idempotent: the service may be
# restarted at any time.
setup() {
    ip -4 rule del priority "$RULE_PRIO" 2>/dev/null
    ip -4 rule del priority "$SELF_PRIO" 2>/dev/null
    ip -4 rule del priority "$WAN_PRIO" 2>/dev/null
    ip -4 rule add iif "$CLIENT_DEV" lookup "$TABLE" priority "$RULE_PRIO"
    ip -4 rule add from "$my_ip" lookup "$TABLE" priority "$SELF_PRIO"
    route_block
    write_dns "$my_ip"
}

# Waits up to 30 s for the TUN device of a restarted Yggdrasil
wait_dev() {
    local i=0
    while [ "$i" -lt 30 ]; do
        ip link show "$YGG_DEV" >/dev/null 2>&1 && return 0
        sleep 1
        i=$((i + 1))
    done
    return 1
}

# Makes exit number $1 the active one: restarts Yggdrasil with it unless it
# runs with it already, then routes the client IPv4 into it
activate() {
    local e a r
    eval "e=\$exit_$1 a=\$addr_$1 r=\$rtt_$1"
    active=$1 fails=0
    if [ "$e" != "$running" ]; then
        log "Switching to exit $e ($a, ${r:-?} ms), restarting Yggdrasil"
        echo "$e" > "$ACTIVE_FILE"
        /etc/init.d/yggdrasil restart
        running=$(running_exit)
        wait_dev || log "Yggdrasil did not come back"
    else
        echo "$e" > "$ACTIVE_FILE"
        log "Using exit $e ($a, ${r:-?} ms)"
    fi
    route_exit || log "No ${YGG_DEV} device, the exit is not routed yet"
}

# No exit: the client IPv4 goes nowhere. Yggdrasil keeps its configuration.
deactivate() {
    route_block
    active=0
}

# Pings Yggdrasil address $1 (-6) or IPv4 addresses from the node's address
# ($1 = -4). On success prints the round trip time in ms and returns 0.
ping_rtt() {
    local t ip
    if [ "$1" = "-4" ]; then
        for ip in 1.1.1.1 8.8.8.8; do
            t=$(ping -4 -c 1 -W 5 -I "$my_ip" "$ip" 2>/dev/null | sed -n 's/.* time=\([0-9.]*\) ms.*/\1/p')
            [ -n "$t" ] && break
        done
    else
        t=$(ping -6 -c 1 -W 5 "$1" 2>/dev/null | sed -n 's/.* time=\([0-9.]*\) ms.*/\1/p')
    fi
    [ -n "$t" ] || return 1
    echo "$t" | awk '{ printf "%d\n", $1 + 0.5 }'
}

# Checks WAN: a ping answer from 1.1.1.1 or 8.8.8.8 sent by the node itself.
# Returns 2 without a default route (nothing to wait for), 1 on failure.
check_wan() {
    local ip
    [ -n "$(ip -4 route show default)" ] || return 2
    for ip in 1.1.1.1 8.8.8.8; do
        ping -4 -c 1 -W 5 "$ip" >/dev/null 2>&1 && return 0
    done
    return 1
}

# wan_exit: sends the client IPv4 to WAN ($1 = 1) or to the exits ($1 = 0)
wan_use() {
    ip -4 rule del priority "$WAN_PRIO" 2>/dev/null
    if [ "$1" = 1 ]; then
        ip -4 rule add iif "$CLIENT_DEV" lookup main priority "$WAN_PRIO"
        log "WAN works, clients use it directly"
    else
        log "WAN does not work, clients use the exits"
    fi
    wan_up=$1
}

# wan_exit: one WAN check and the switch it calls for
update_wan() {
    local r
    check_wan
    r=$?
    if [ "$r" -eq 0 ]; then
        wan_fails=0 wan_streak=$((wan_streak + 1))
        [ "$wan_up" = 1 ] || [ "$wan_streak" -lt "$WAN_UP_LIMIT" ] || wan_use 1
    else
        wan_fails=$((wan_fails + 1)) wan_streak=0
        if [ "$wan_up" = 1 ] && { [ "$r" -eq 2 ] || [ "$wan_fails" -ge "$FAIL_LIMIT" ]; }; then
            wan_use 0
        fi
    fi
}

# TERM: a restart or a stop. The client IPv4 goes nowhere until setup() of the
# next run or cleanup() replaces the routing.
shutdown() {
    route_block
    rm -f "$STATUS_FILE"
    log "Stopped"
    exit 0
}

write_status() {
    local e="" a="" r=""
    [ "$active" -gt 0 ] && eval "e=\$exit_$active a=\$addr_$active r=\$rtt_$active"
    printf 'exit=%s\naddress=%s\nrtt=%s\nwan=%s\n' "$e" "$a" "$r" "$wan_up" > "${STATUS_FILE}.new" \
        && mv "${STATUS_FILE}.new" "$STATUS_FILE"
}

# Removes everything setup(), activate() and wan_use() created: the service
# was stopped for good (another clearnet mode). In the exit mode client IPv4
# still has no way out: the firewall has no LAN -> WAN forwarding then.
cleanup() {
    rm -f "$STATUS_FILE" "$ACTIVE_FILE"
    ip -4 rule del priority "$RULE_PRIO" 2>/dev/null
    ip -4 rule del priority "$SELF_PRIO" 2>/dev/null
    ip -4 rule del priority "$WAN_PRIO" 2>/dev/null
    ip -4 route flush table "$TABLE" 2>/dev/null
    write_dns ""
    return 0
}

# Pings every exit over Yggdrasil once: ok_N (1/0), streak_N (successful
# checks in a row) and rtt_N (smoothed latency in ms, kept while it fails)
check_all() {
    local i a t r streak
    i=1
    while [ "$i" -le "$n" ]; do
        eval "a=\$addr_$i r=\$rtt_$i streak=\$streak_$i"
        if t=$(ping_rtt "$a"); then
            [ -n "$r" ] && t=$(((3 * r + t) / 4))
            eval "ok_$i=1 rtt_$i=\$t streak_$i=$((streak + 1))"
        else
            eval "ok_$i=0 streak_$i=0"
        fi
        i=$((i + 1))
    done
}

# Prints the number of the fastest reachable exit other than $1 with at least
# $2 successful checks in a row and out of its COOLDOWN, or 0. Ties go to the
# configured order.
fastest() {
    local i best=0 bestr=0 ok r streak bad now
    now=$(date +%s)
    i=1
    while [ "$i" -le "$n" ]; do
        eval "ok=\$ok_$i r=\$rtt_$i streak=\$streak_$i bad=\$bad_$i"
        if [ "$i" != "$1" ] && [ "$ok" = 1 ] && [ "$streak" -ge "$2" ] \
            && [ $((now - bad)) -ge "$COOLDOWN" ] \
            && { [ "$best" -eq 0 ] || [ "$r" -lt "$bestr" ]; }; then
            best=$i bestr=$r
        fi
        i=$((i + 1))
    done
    echo "$best"
}

# Prints the number of the exit Yggdrasil runs with when it is reachable, or 0
running_index() {
    local i e ok
    i=1
    while [ "$i" -le "$n" ]; do
        eval "e=\$exit_$i ok=\$ok_$i"
        [ "$e" = "$running" ] && [ "$ok" = 1 ] && { echo "$i"; return; }
        i=$((i + 1))
    done
    echo 0
}

run() {
    local exits e i t ar br mode key
    active=0 fails=0 n=0 wan_up=0 wan_fails=0 wan_streak=0

    mode=$(uci -q get yggmesh.clearnet.mode)
    exits=$(uci -q get yggmesh.clearnet.exit | tr 'A-F' 'a-f')
    [ -n "$exits" ] || { log "No exits configured"; exit 0; }
    key=$(uci -q get yggmesh.yggdrasil.private_key)
    my_ip=$(key_ipv4 "$(pubkey_of "$key")")
    running=$(running_exit)

    trap shutdown INT TERM
    setup
    # A working WAN is used at once, a failed one is not waited for
    if [ "$mode" = "wan_exit" ]; then
        if check_wan; then
            wan_use 1
        else
            wan_use 0
        fi
    fi

    # exit_N is the public key, addr_N its Yggdrasil address
    for e in $exits; do
        is_pubkey "$e" || continue
        n=$((n + 1))
        eval "exit_$n=\$e addr_$n=\$(key_address \"\$e\") ok_$n=0 streak_$n=0 rtt_$n='' bad_$n=0"
    done
    log "Clearnet through $n exit(s) as ${my_ip}: $exits"

    # Yggdrasil started with an exit already: it is the active one until its
    # checks fail, no restart
    i=1
    while [ "$i" -le "$n" ]; do
        eval "e=\$exit_$i"
        [ "$e" = "$running" ] && activate "$i"
        i=$((i + 1))
    done

    while :; do
        check_all
        [ "$mode" = "wan_exit" ] && update_wan

        if [ "$active" -gt 0 ]; then
            route_exit
            if t=$(ping_rtt -4); then
                fails=0
            else
                fails=$((fails + 1))
                if [ "$fails" -ge "$FAIL_LIMIT" ]; then
                    eval "log \"Exit \$exit_$active does not work\""
                    eval "bad_$active=\$(date +%s)"
                    deactivate
                fi
            fi
        fi

        if [ "$active" -eq 0 ]; then
            i=$(fastest 0 1)
            [ "$i" -gt 0 ] || i=$(running_index)
            [ "$i" -gt 0 ] && activate "$i"
        else
            i=$(fastest "$active" "$RETURN_LIMIT")
            if [ "$i" -gt 0 ]; then
                eval "ar=\$rtt_$active br=\$rtt_$i"
                if [ -n "$ar" ] && [ $((br * 100)) -lt $((ar * SWITCH_PCT)) ] \
                    && [ $((ar - br)) -ge "$SWITCH_MS" ]; then
                    eval "log \"Exit \$exit_$i is faster (\$br ms vs \$ar ms)\""
                    activate "$i"
                fi
            fi
        fi

        write_status

        # Background sleep, so that TERM is handled at once
        sleep "$CHECK_INTERVAL" &
        wait $!
    done
}

case "$1" in
    run) run ;;
    cleanup) cleanup ;;
    current) current ;;
    *) echo "Usage: $0 run | cleanup | current" >&2; exit 1 ;;
esac
