#!/bin/sh
# shellcheck disable=SC3043
# rpcd plugin of the YggMesh page in LuCI (view/yggmesh/settings.js)
#   generateKey               a new Yggdrasil private key (not saved)
#   keyInfo { private_key }   the node address and client subnet of a key
#   status                    the running node: address, peers, clearnet

. /usr/share/libubox/jshn.sh

SOCK="unix:///tmp/yggdrasil/yggdrasil.sock"
CLEARNET_STATUS="/var/run/yggmesh-clearnet.status"

# Prints "address subnet" of private key $1 (128 hex digits), or nothing
key_info() {
	local tmp address subnet
	case "$1" in
		*[!0-9a-fA-F]*) return ;;
	esac
	[ "${#1}" -eq 128 ] || return
	tmp=$(mktemp)
	echo "{ PrivateKey: \"$1\" }" > "$tmp"
	address=$(yggdrasil -address -useconffile "$tmp" 2>/dev/null)
	subnet=$(yggdrasil -subnet -useconffile "$tmp" 2>/dev/null)
	rm -f "$tmp"
	[ -n "$address" ] && [ -n "$subnet" ] && echo "$address $subnet"
}

# Prints the value of key $1 in the clearnet status file
clearnet_status() {
	sed -n "s/^$1=//p" "$CLEARNET_STATUS" 2>/dev/null
}

case "$1" in
	list)
		json_init
		json_add_object generateKey
		json_close_object
		json_add_object keyInfo
		json_add_string private_key ""
		json_close_object
		json_add_object status
		json_close_object
		json_dump
		;;
	call)
		case "$2" in
			generateKey)
				json_init
				json_add_string private_key "$(yggdrasil -genconf -json 2>/dev/null | jsonfilter -e '@.PrivateKey')"
				json_dump
				;;
			keyInfo)
				read -r input
				json_load "$input"
				key=""
				json_get_var key private_key
				info=$(key_info "$key")
				json_init
				if [ -n "$info" ]; then
					json_add_string address "${info% *}"
					json_add_string subnet "${info#* }"
				else
					json_add_string error "invalid private key"
				fi
				json_dump
				;;
			status)
				peers=$(yggdrasilctl -json -endpoint="$SOCK" getPeers 2>/dev/null)
				json_init
				json_add_string address "$(ip -6 -o addr show dev yggdrasil scope global 2>/dev/null | awk '{ sub(/\/.*/, "", $4); print $4 }' | grep -m1 '^2')"
				json_add_int peers_up "$(echo "$peers" | jsonfilter -e '@.peers[@.up=true].remote' 2>/dev/null | wc -l)"
				json_add_int peers "$(echo "$peers" | jsonfilter -e '@.peers[*].remote' 2>/dev/null | wc -l)"
				json_add_string mode "$(uci -q get yggmesh.clearnet.mode)"
				json_add_boolean clearnet_running "$([ -s "$CLEARNET_STATUS" ] && echo 1 || echo 0)"
				json_add_string exit "$(clearnet_status exit)"
				json_add_string exit_address "$(clearnet_status address)"
				json_add_string exit_rtt "$(clearnet_status rtt)"
				json_add_boolean wan "$([ "$(clearnet_status wan)" = 1 ] && echo 1 || echo 0)"
				json_dump
				;;
		esac
		;;
esac
