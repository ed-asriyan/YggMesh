#!/bin/sh

if [ ! -f /etc/ygg_socks_target ]; then
    exit 0
fi

target=$(cat /etc/ygg_socks_target)
host="${target%:*}"
if [ "$host" = "$target" ]; then
    port=1080
else
    port="${target##*:}"
fi

cat > /etc/redsocks.conf <<EOF
base {
    log_debug = off;
    log_info = on;
    log = "syslog:daemon";
    daemon = on;
    redirector = iptables;
}
redsocks {
    local_ip = 0.0.0.0;
    local_port = 12345;
    ip = $host;
    port = $port;
    type = socks5;
}
EOF

/etc/init.d/redsocks enable
/etc/init.d/redsocks start

cat > /etc/firewall.proxy <<EOF
#!/bin/sh

# IPv4
iptables -t nat -N REDSOCKS 2>/dev/null || iptables -t nat -F REDSOCKS
iptables -t nat -A REDSOCKS -d 127.0.0.0/8 -j RETURN
iptables -t nat -A REDSOCKS -d 192.168.0.0/16 -j RETURN
iptables -t nat -A REDSOCKS -d 0.0.0.0/8 -j RETURN
iptables -t nat -A REDSOCKS -p tcp -j REDIRECT --to-ports 12345
iptables -t nat -I PREROUTING -i br-lan -p tcp -j REDSOCKS

# IPv6
ip6tables -t nat -N REDSOCKS 2>/dev/null || ip6tables -t nat -F REDSOCKS
ip6tables -t nat -A REDSOCKS -d ::1/128 -j RETURN
ip6tables -t nat -A REDSOCKS -d fe80::/10 -j RETURN
ip6tables -t nat -A REDSOCKS -d 200::/7 -j RETURN
ip6tables -t nat -A REDSOCKS -p tcp -j REDIRECT --to-ports 12345
ip6tables -t nat -I PREROUTING -i br-lan -p tcp -j REDSOCKS
EOF

chmod +x /etc/firewall.proxy

uci add firewall include
uci set firewall.@include[-1].path='/etc/firewall.proxy'
uci set firewall.@include[-1].reload='1'
uci commit firewall

/etc/init.d/firewall restart

rm -f /etc/ygg_socks_target
