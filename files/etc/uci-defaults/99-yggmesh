#!/bin/sh
# YggMesh — runs once after every flash (fresh install or kept settings).
# yggmesh-defaults fills in or migrates the user settings in
# /etc/config/yggmesh, yggmesh-apply builds the node configuration from them.
# On failure the script stays and runs again on the next boot.

/usr/sbin/yggmesh-defaults && /usr/sbin/yggmesh-apply --boot
