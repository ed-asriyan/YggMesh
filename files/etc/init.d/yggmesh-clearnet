#!/bin/sh /etc/rc.common
# Clearnet access through Yggdrasil exit nodes, see /usr/sbin/yggmesh-clearnet

START=95
USE_PROCD=1

start_service() {
	[ -n "$(uci -q get yggmesh.clearnet.exit)" ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/yggmesh-clearnet run
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger yggmesh
}
