#!/bin/sh /etc/rc.common
# Clearnet access through Yggdrasil exit nodes, see /usr/sbin/yggmesh-clearnet.
# Enabled, reloaded and stopped by yggmesh-apply for the clearnet mode.

START=95
USE_PROCD=1

start_service() {
	case "$(uci -q get yggmesh.clearnet.mode)" in
		exit|wan_exit) ;;
		*) return 0 ;;
	esac
	[ -n "$(uci -q get yggmesh.clearnet.exit)" ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/yggmesh-clearnet run
	# A changed clearnet section restarts the daemon on reload
	procd_set_param env YGGMESH_CLEARNET="$(uci -q show yggmesh.clearnet | md5sum | cut -d' ' -f1)"
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

service_stopped() {
	/usr/sbin/yggmesh-clearnet cleanup
}
