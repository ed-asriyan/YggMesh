#!/bin/sh /etc/rc.common
# Applies /etc/config/yggmesh whenever it changes, see /usr/sbin/yggmesh-apply.
# No process: the service only holds the reload trigger.

START=19
USE_PROCD=1

start_service() {
	:
}

reload_service() {
	/usr/sbin/yggmesh-apply
}

service_triggers() {
	procd_add_reload_trigger yggmesh
}
